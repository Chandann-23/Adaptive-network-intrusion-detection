# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Local configurations & secrets
.env
.env.*
*.local

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo

# Data and Model storage (Essential MLOps practices)
data/raw/*.csv
data/raw/*.txt
data/raw/*.gz
data/raw/*.zip
data/processed/*.csv
data/processed/*.npz
data/processed/*.pkl
# Exclude large processed parquets from git (too large, reproducible from raw data)
data/processed/*.parquet
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Exclude all model binaries by default (large experiment artifacts)
models/*.pkl
models/*.joblib
models/*.h5
models/*.onnx
models/*.pt
models/**/*.joblib
models/**/*.pkl
!models/.gitkeep

# EXCEPTION: Include serving assets required for HF Spaces deployment
# These are tiny (~7KB preprocessor and ~1.6MB model)
!data/processed/preprocessing_pipeline.joblib
!models/multiclass/hybrid_pipeline/model.joblib

# System specific files
.DS_Store
Thumbs.db
